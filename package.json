{
  "name": "yopem-auth",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "db:check": "drizzle-kit check",
    "db:drop": "drizzle-kit drop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:pull": "drizzle-kit introspect",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:up": "drizzle-kit up",
    "build": "bun build --compile ./src/index.ts --outfile start --minify",
    "dev": "bun run --hot src/index.ts",
    "start": "./start",
    "fmt:check": "bun fmt --check",
    "fmt:write": "bun fmt",
    "lint": "bun lint --type-aware",
    "lint:fix": "bun lint --fix",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@openauthjs/openauth": "^0.4.3",
    "drizzle-orm": "^0.45.4",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "transliteration": "^2.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@yopem/eslint-plugin": "^0.1.0",
    "@yopem/typescript-config": "^0.2.5",
    "drizzle-kit": "^0.31.11",
    "eslint-plugin-oxfmt": "^0.33.0",
    "lefthook": "^2.2.2"
  },
  "packageManager": "bun@1.4.4-cannary.1"
}
